#!/usr/bin/env python3
"""
Squad CLI: orchestrate multiple AI agents across tmux panes via a file-based
message bus. One command dispatches to your agents (e.g. OpenClaw, Claude Code, Gemini, Cursor);
they read missions from disk and write reports back; you aggregate and review.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from datetime import datetime, timezone

# ANSI colors (bright) for agent output; reset and no-color sentinel
_RESET = "\033[0m"
_AGENT_COLORS = [
    "\033[1;36m",   # cyan  (first agent)
    "\033[1;35m",   # magenta (Claude)
    "\033[1;32m",   # green (Gemini)
    "\033[1;34m",   # blue (Auto)
    "\033[1;33m",   # yellow
    "\033[1;31m",   # red
]
_DONE = "\033[1;32m"
_PENDING = "\033[2;33m"


def _use_color() -> bool:
    if os.environ.get("NO_COLOR"):
        return False
    return hasattr(sys.stdout, "isatty") and sys.stdout.isatty()


def _agent_color(agent_index: int, use_color: bool) -> tuple[str, str]:
    if not use_color:
        return "", ""
    c = _AGENT_COLORS[agent_index % len(_AGENT_COLORS)]
    return c, _RESET


def _print_agent_block(agent_name: str, body: str, agent_index: int, use_color: bool) -> None:
    pre, post = _agent_color(agent_index, use_color)
    print(f"\n{pre}--- {agent_name} ---{post}\n")
    print(body.rstrip())
    if body and not body.endswith("\n"):
        print()

CONFIG_NAME = "config.json"
CONFIG_ENV = "SQUAD_CONFIG"
DEFAULT_WORKSPACE = "~/ai-squad/workspace"


def get_config_path() -> Path:
    if os.environ.get(CONFIG_ENV):
        return Path(os.environ[CONFIG_ENV]).expanduser().resolve()
    return Path(__file__).resolve().parent / CONFIG_NAME


def load_config() -> dict:
    path = get_config_path()
    if not path.exists():
        example = Path(__file__).resolve().parent / "config.example.json"
        raise SystemExit(
            f"Config not found at {path}. Copy config.example.json to config.json and set tmux panes.\n"
            f"  cp {example} {path}"
        )
    with open(path) as f:
        return json.load(f)


def get_workspace_root(config: dict) -> Path:
    raw = config.get("workspace", DEFAULT_WORKSPACE)
    return Path(raw).expanduser().resolve()


def ensure_workspace(workspace: Path, config: dict | None = None) -> None:
    (workspace / "missions").mkdir(parents=True, exist_ok=True)
    (workspace / "handoffs").mkdir(parents=True, exist_ok=True)
    for agent in get_agents_from_config(config):
        (workspace / "inbox" / agent["id"]).mkdir(parents=True, exist_ok=True)
        (workspace / "outbox" / agent["id"]).mkdir(parents=True, exist_ok=True)


def get_agents_from_config(config: dict | None = None) -> list:
    if config is None:
        config = load_config()
    return config.get("agents", [])


def tmux_send(target: str, text: str, literal: bool = True) -> None:
    """Send keys to a tmux pane. target e.g. 'squad:0.0'."""
    args = ["tmux", "send-keys", "-t", target]
    if literal:
        args.append("-l")
    args.append(text)
    subprocess.run(args, check=True)


def tmux_send_enter(target: str) -> None:
    subprocess.run(["tmux", "send-keys", "-t", target, "Enter"], check=True)


def cmd_run(config: dict, mission_text: str) -> None:
    workspace = get_workspace_root(config)
    ensure_workspace(workspace, config)
    mission_id = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    mission_path = workspace / "missions" / f"{mission_id}_mission.md"
    mission_path.write_text(mission_text.strip() + "\n", encoding="utf-8")

    outbox_dir = workspace / "outbox"
    agents = get_agents_from_config(config)
    for agent in agents:
        aid = agent["id"]
        report_path = outbox_dir / aid / f"{mission_id}.md"
        instruction = (
            f"Mission: {mission_path}\n"
            f"When done, save your report to: {report_path}\n"
            f"Then you can continue or wait for the next mission."
        )
        inbox_file = workspace / "inbox" / aid / f"{mission_id}.txt"
        inbox_file.write_text(instruction, encoding="utf-8")

        target = agent.get("tmux")
        if not target:
            print(f"[skip] {agent.get('name', aid)}: no tmux target", file=sys.stderr)
            continue
        session = config.get("tmux_session", "squad")
        if ":" not in target and session:
            target = f"{session}:{target}"
        try:
            tmux_send(target, f"# Squad mission {mission_id} — read: {inbox_file}")
            tmux_send_enter(target)
        except subprocess.CalledProcessError as e:
            print(f"[warn] Could not send to {target}: {e}", file=sys.stderr)

    print(f"Mission {mission_id} created and dispatched.")
    print(f"  Mission file: {mission_path}")
    print(f"  Check reports: squad status {mission_id}")


def cmd_status(config: dict, mission_id: str | None, use_color: bool | None = None) -> None:
    if use_color is None:
        use_color = _use_color()
    workspace = get_workspace_root(config)
    outbox = workspace / "outbox"
    if not outbox.exists():
        print("No workspace outbox yet. Run a mission first.")
        return

    agents = get_agents_from_config(config)
    if mission_id:
        for i, agent in enumerate(agents):
            path = outbox / agent["id"] / f"{mission_id}.md"
            done = path.exists()
            status = "done" if done else "pending"
            if use_color:
                c = _DONE if done else _PENDING
                print(f"  {c}{agent['name']}: {status}{_RESET}")
            else:
                print(f"  {agent['name']}: {status}")
    else:
        missions = set()
        for aid in (outbox / a["id"] for a in agents if (outbox / a["id"]).exists()):
            for f in aid.iterdir():
                if f.suffix == ".md":
                    missions.add(f.stem)
        for mid in sorted(missions, reverse=True)[:20]:
            print(mid)


def cmd_report(config: dict, mission_id: str, use_color: bool | None = None) -> None:
    if use_color is None:
        use_color = _use_color()
    workspace = get_workspace_root(config)
    outbox = workspace / "outbox"
    if not mission_id:
        raise SystemExit("Usage: squad report <mission_id>")

    agents = get_agents_from_config(config)
    for i, agent in enumerate(agents):
        path = outbox / agent["id"] / f"{mission_id}.md"
        if path.exists():
            _print_agent_block(agent["name"], path.read_text(encoding="utf-8"), i, use_color)


def cmd_handoff(config: dict, from_agent: str, to_agent: str, task: str) -> None:
    workspace = get_workspace_root(config)
    ensure_workspace(workspace, config)
    agents_by_id = {a["id"]: a for a in get_agents_from_config(config)}
    if to_agent not in agents_by_id:
        raise SystemExit(f"Unknown agent: {to_agent}. Choose from: {list(agents_by_id)}")

    handoff_id = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    inbox_path = workspace / "inbox" / to_agent / f"handoff_{handoff_id}.txt"
    inbox_path.write_text(f"Handoff from {from_agent}:\n\n{task}\n", encoding="utf-8")

    target = agents_by_id[to_agent].get("tmux")
    if target:
        session = config.get("tmux_session", "squad")
        if ":" not in target and session:
            target = f"{session}:{target}"
        try:
            tmux_send(target, f"# Handoff from {from_agent} — read: {inbox_path}")
            tmux_send_enter(target)
        except subprocess.CalledProcessError as e:
            print(f"[warn] Could not notify pane: {e}", file=sys.stderr)

    print(f"Handoff to {to_agent} written to {inbox_path}")


def cmd_up(config: dict) -> None:
    """Ensure squad tmux session exists, print pane→agent map, then attach."""
    session = config.get("tmux_session", "squad")
    agents = get_agents_from_config(config)

    try:
        result = subprocess.run(
            ["tmux", "has-session", "-t", session],
            capture_output=True,
            check=False,
        )
        has_session = result.returncode == 0
    except FileNotFoundError:
        raise SystemExit("tmux not found. Install tmux and try again.")

    if not has_session:
        subprocess.run(["tmux", "new-session", "-d", "-s", session], check=True)
        subprocess.run(["tmux", "split-window", "-t", f"{session}", "-h"], check=True)
        subprocess.run(["tmux", "split-window", "-t", f"{session}", "-v"], check=True)
        subprocess.run(["tmux", "select-pane", "-t", f"{session}:0.0"], check=True)
        subprocess.run(["tmux", "split-window", "-t", f"{session}", "-v"], check=True)
        for i, agent in enumerate(agents):
            pane = agent.get("tmux", "").split(":")[-1] or f"0.{i}"
            target = f"{session}:{pane}"
            launch = agent.get("launch", "").strip()
            if launch:
                text = launch
            else:
                text = f"# {agent.get('name', agent['id'])} — start your agent here"
            try:
                tmux_send(target, text)
                tmux_send_enter(target)
            except subprocess.CalledProcessError as e:
                print(f"[warn] Could not send to {target}: {e.stderr or e}", file=sys.stderr)

    print("Squad session:", session)
    print("Start each agent in its pane (launch = free mode, no permission prompts):")
    for agent in agents:
        target = agent.get("tmux", "?")
        if ":" not in target and session:
            target = f"{session}:{target}"
        launch = agent.get("launch", "").strip() or "(no launch set)"
        print(f"  {target}  →  {agent.get('name', agent['id'])}")
        print(f"           run: {launch}")
    print("\nTrigger missions from any terminal: squad run 'your mission'")
    print("Attaching to session now.\n")
    subprocess.run(["tmux", "attach-session", "-t", session])


TEST_MISSION = """Squad smoke test. Your only job:
1. Read the inbox file path that was pasted into your pane.
2. Reply with one short line: your agent name (Cami, Claude, Gemini, or Auto) and "received."
3. Save that line as your report to the exact outbox path listed in that inbox file.

No other work required. This verifies the squad pipeline."""


def cmd_test(config: dict) -> None:
    """Dispatch a canned smoke-test mission; print mission_id for status/report."""
    cmd_run(config, TEST_MISSION)


def cmd_watch(config: dict, mission_id: str, interval: float = 2.0, use_color: bool | None = None) -> None:
    """Poll outbox and print each agent's report as it appears, color-coded. Exit when all in."""
    if use_color is None:
        use_color = _use_color()
    workspace = get_workspace_root(config)
    outbox = workspace / "outbox"
    agents = get_agents_from_config(config)
    printed: set[str] = set()

    print(f"Watching for reports: mission {mission_id} (poll every {interval}s). Ctrl+C to stop.\n")
    try:
        while True:
            for i, agent in enumerate(agents):
                aid = agent["id"]
                if aid in printed:
                    continue
                path = outbox / aid / f"{mission_id}.md"
                if path.exists():
                    _print_agent_block(agent["name"], path.read_text(encoding="utf-8"), i, use_color)
                    printed.add(aid)
            if len(printed) >= len(agents):
                pre, post = (_DONE, _RESET) if use_color else ("", "")
                print(f"\n{pre}All agents reported.{post}")
                break
            time.sleep(interval)
    except KeyboardInterrupt:
        print(f"\nStopped. {len(printed)}/{len(agents)} reports so far.")


def cmd_setup() -> None:
    """Copy config.example.json → config.json if missing; create workspace dirs. Safe to run multiple times."""
    config_path = get_config_path()
    example_path = Path(__file__).resolve().parent / "config.example.json"
    if not config_path.exists():
        if not example_path.exists():
            raise SystemExit(f"Neither {config_path} nor {example_path} found.")
        shutil.copy(example_path, config_path)
        print(f"Created {config_path} from config.example.json")
    else:
        print(f"Config already exists: {config_path}")
    config = load_config()
    workspace = get_workspace_root(config)
    ensure_workspace(workspace, config)
    print(f"Workspace ready: {workspace}")
    print("Next: edit config.json (tmux panes + launch commands), then run squad up")


def cmd_doctor(config: dict) -> None:
    """Validate config, tmux, and squad session/panes."""
    ok = True
    try:
        subprocess.run(["tmux", "-V"], capture_output=True, check=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        print("tmux: not found or not runnable")
        ok = False
    else:
        print("tmux: OK")
    session = config.get("tmux_session", "squad")
    try:
        result = subprocess.run(["tmux", "has-session", "-t", session], capture_output=True, check=False)
        if result.returncode != 0:
            print(f"Session '{session}': not found (run squad up to create)")
            ok = False
        else:
            print(f"Session '{session}': exists")
            for agent in get_agents_from_config(config):
                target = agent.get("tmux", "")
                if ":" not in target:
                    target = f"{session}:{target}"
                try:
                    subprocess.run(["tmux", "display-message", "-t", target, "-p", ""], capture_output=True, check=True)
                    print(f"  Pane {target}: OK")
                except subprocess.CalledProcessError:
                    print(f"  Pane {target}: not found")
                    ok = False
    except Exception as e:
        print(f"Session check failed: {e}")
        ok = False
    workspace = get_workspace_root(config)
    if workspace.exists() and os.access(workspace, os.W_OK):
        print(f"Workspace {workspace}: writable")
    else:
        workspace.mkdir(parents=True, exist_ok=True)
        if os.access(workspace, os.W_OK):
            print(f"Workspace {workspace}: created and writable")
        else:
            print(f"Workspace {workspace}: not writable")
            ok = False
    if not ok:
        sys.exit(1)


def cmd_send_one(config: dict, agent_id: str, message: str) -> None:
    """Send a message to one agent only (inbox + tmux notify)."""
    workspace = get_workspace_root(config)
    ensure_workspace(workspace, config)
    agents_by_id = {a["id"]: a for a in get_agents_from_config(config)}
    if agent_id not in agents_by_id:
        raise SystemExit(f"Unknown agent: {agent_id}. Choose from: {list(agents_by_id)}")

    msg_id = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    inbox_path = workspace / "inbox" / agent_id / f"msg_{msg_id}.txt"
    inbox_path.write_text(message.strip() + "\n", encoding="utf-8")

    agent = agents_by_id[agent_id]
    target = agent.get("tmux")
    if target:
        session = config.get("tmux_session", "squad")
        if ":" not in target and session:
            target = f"{session}:{target}"
        try:
            tmux_send(target, f"# Message for you — read: {inbox_path}")
            tmux_send_enter(target)
        except subprocess.CalledProcessError as e:
            print(f"[warn] Could not notify pane: {e}", file=sys.stderr)
    print(f"Sent to {agent.get('name', agent_id)}: {inbox_path}")


def cmd_chat(config: dict) -> None:
    """Interactive CLI: type a line to broadcast to all, or @agent_id message to message one."""
    agents_by_id = {a["id"]: a for a in get_agents_from_config(config)}
    agent_ids = list(agents_by_id)

    print("Squad chat — one pane to rule them all.")
    print("  Type a line and Enter  →  broadcast to all four")
    print("  @agent message        →  send only to that agent (e.g. @gemini do the API)")
    print("  /status [id]          →  show status for mission id")
    print("  /report <id>          →  print all reports for mission id")
    print("  /watch <id>           →  stream reports into this window as they arrive (color-coded)")
    print("  /quit or /exit        →  leave chat")
    print(f"  Agents: {', '.join(agent_ids)}")
    print()

    while True:
        try:
            line = input("squad> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not line:
            continue
        if line in ("/quit", "/exit"):
            break
        if line.startswith("/status"):
            rest = line[7:].strip()
            cmd_status(config, rest if rest else None)
            continue
        if line.startswith("/report"):
            mid = line[7:].strip()
            if mid:
                cmd_report(config, mid)
            else:
                print("Usage: /report <mission_id>")
            continue
        if line.startswith("/watch"):
            mid = line[6:].strip()
            if mid:
                cmd_watch(config, mid)
            else:
                print("Usage: /watch <mission_id>")
            continue
        if line.startswith("@"):
            parts = line[1:].split(None, 1)
            aid = parts[0].lower()
            msg = parts[1] if len(parts) > 1 else ""
            if aid in agents_by_id and msg:
                cmd_send_one(config, aid, msg)
            elif aid in agents_by_id:
                print("Give a message after the agent id, e.g. @gemini your task here")
            else:
                print(f"Unknown agent '{aid}'. Use one of: {agent_ids}")
            continue
        cmd_run(config, line)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Orchestrate AI agents across tmux panes (Cami, Claude, Gemini, Auto)."
    )
    sub = parser.add_subparsers(dest="command", required=True)

    run_p = sub.add_parser("run", help="Create a mission and dispatch to all agents")
    run_p.add_argument("mission", nargs="*", help="Mission text (or stdin)")
    run_p.add_argument("-f", "--file", help="Read mission from file")

    status_p = sub.add_parser("status", help="List missions or report status for one")
    status_p.add_argument("mission_id", nargs="?", help="Mission ID (e.g. 20250217_120000)")

    report_p = sub.add_parser("report", help="Print all agent reports for a mission (color-coded)")
    report_p.add_argument("mission_id", help="Mission ID")
    report_p.add_argument("--no-color", action="store_true", help="Disable colored output")
    status_p.add_argument("--no-color", action="store_true", help="Disable colored output")

    handoff_p = sub.add_parser("handoff", help="Send a task from one agent to another")
    handoff_p.add_argument("--from", dest="from_agent", required=True, help="Sender agent id")
    handoff_p.add_argument("--to", dest="to_agent", required=True, help="Receiver agent id")
    handoff_p.add_argument("task", nargs="*", help="Task text (or stdin)")

    sub.add_parser("up", help="Create/attach to squad tmux session and show pane→agent map")
    sub.add_parser("test", help="Dispatch a smoke-test mission (same as run with canned message)")
    sub.add_parser("chat", help="Interactive CLI: type to broadcast, or @agent message to message one")
    send_p = sub.add_parser("send", help="Send a message to one agent only")
    send_p.add_argument("agent_id", help="Agent id (cami, claude, gemini, auto)")
    send_p.add_argument("message", nargs="*", help="Message text")
    watch_p = sub.add_parser("watch", help="Stream agent reports into this window as they arrive (color-coded)")
    watch_p.add_argument("mission_id", help="Mission ID")
    watch_p.add_argument("--interval", "-n", type=float, default=2.0, help="Poll interval in seconds (default: 2)")
    watch_p.add_argument("--no-color", action="store_true", help="Disable colored output")
    sub.add_parser("setup", help="Copy config.example.json → config.json if missing; create workspace")
    sub.add_parser("doctor", help="Validate config, tmux, and squad session/panes")

    args = parser.parse_args()

    if args.command == "setup":
        cmd_setup()
        return
    config = load_config()
    if args.command == "doctor":
        cmd_doctor(config)
        return

    if args.command == "run":
        if args.file:
            mission_text = Path(args.file).expanduser().resolve().read_text(encoding="utf-8")
        elif args.mission:
            mission_text = " ".join(args.mission)
        else:
            mission_text = sys.stdin.read()
        if not mission_text.strip():
            raise SystemExit("Empty mission. Provide text, -f <file>, or stdin.")
        cmd_run(config, mission_text)

    elif args.command == "status":
        use_color = False if getattr(args, "no_color", False) else None
        cmd_status(config, getattr(args, "mission_id", None), use_color=use_color)

    elif args.command == "report":
        use_color = False if getattr(args, "no_color", False) else None
        cmd_report(config, getattr(args, "mission_id", ""), use_color=use_color)

    elif args.command == "watch":
        use_color = False if args.no_color else None
        cmd_watch(config, args.mission_id, interval=args.interval, use_color=use_color)

    elif args.command == "handoff":
        task = " ".join(args.task) if args.task else sys.stdin.read()
        if not task.strip():
            raise SystemExit("Empty task. Provide text or stdin.")
        cmd_handoff(config, args.from_agent, args.to_agent, task.strip())

    elif args.command == "up":
        cmd_up(config)

    elif args.command == "test":
        cmd_test(config)

    elif args.command == "chat":
        cmd_chat(config)

    elif args.command == "send":
        msg = " ".join(args.message) if args.message else sys.stdin.read()
        if not msg.strip():
            raise SystemExit("Usage: squad send <agent_id> <message>")
        cmd_send_one(config, args.agent_id, msg.strip())


if __name__ == "__main__":
    main()
